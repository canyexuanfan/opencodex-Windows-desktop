{
  "name": "@bitkyc08/opencodex-desktop",
  "version": "2.10.0",
  "buildRevision": 1,
  "private": true,
  "description": "OpenCodex Windows desktop host",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests",
    "package:resources": "bun ../scripts/prepare-desktop-resources.ts",
    "package": "bun run package:resources && bun run build && electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.12.3",
    "electron": "43.2.0",
    "electron-builder": "26.12.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.opencodex.desktop",
    "productName": "OpenCodex",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/builder-debug.yml",
      "!resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/staging/opencodex",
        "to": "opencodex"
      },
      {
        "from": "resources/staging/opencodex/node_modules",
        "to": "opencodex/node_modules",
        "filter": ["**/*", "!bun{,/**/*}", "!@oven{,/**/*}"]
      },
      {
        "from": "../src/tray/assets",
        "to": "tray"
      }
    ],
    "directories": {
      "output": "out"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "selectPerMachineByDefault": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "unicode": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": "OpenCodex",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "OpenCodex-Setup-${version}-x64.${ext}"
    }
  }
}
